# Copy this to config.env and edit for each Pi

# Path to the video file
VIDEO=/home/pipe/video.mp4

# Video duration in seconds (for loop position sync)
# 40 min = 2400, 90 min = 5400
DURATION=2400

# Master Pi IP — used by client for late-join recovery
# setup-autostart.sh sets this to localhost on the master automatically.
# On slaves, set this to the master Pi's IP address.
SERVER_IP=192.168.2.x

# KMS output mode for mpv --vo=drm (overrides EDID negotiation).
# Format: <w>x<h>@<hz>
# Production projectors (3840x2160):  DRM_MODE=3840x2160@25
# 21:9 dev monitor (25fps content):   DRM_MODE=3440x1440@49.99
# Run: mpv --vo=drm --drm-mode=help /dev/null  to list available modes.
# Leave unset to use the monitor's preferred/negotiated mode.
#DRM_MODE=

# Role of this Pi — set automatically by setup-autostart.sh.
# Controls which PTP wait mode runs on boot (master=30s fixed, slave=polls until locked).
#ROLE=slave

# Set to 1 to show a timecode + frame number overlay during playback (sync checking).
# Shows: HH:MM:SS.mmm  f<frame>  — both Pis should match if in sync.
#SYNC_OVERLAY=1

# Player: mpv (default), ffplay, or kodi.
# kodi runs as its own persistent systemd service (systemd/kodi-standalone.service)
# controlled over JSON-RPC — use it on boards where mpv's --vo=drm/zimg render
# pipeline itself is the problem (confirmed on pi2, 2026-09-06/07: identical
# board/monitor/file judders under mpv, plays smooth under Kodi at ~16% CPU vs
# mpv's heavy zimg conversion cost). Kodi has no fractional speed control, so its
# drift correction is hard-seek-only — see KODI_SEEK_THRESHOLD below.
#PLAYER=kodi

# Kodi only: drift in seconds above which to hard-seek. Must sit above Kodi's
# own natural, uncorrected drift band (measured ~200-390ms on pi2) — a lower
# threshold makes sync worse, not better, since seeking every cycle adds more
# noise (100-300ms of its own seek latency) than it corrects. Default in
# client.py is 0.6 (600ms); override here only if a board's own band differs.
#KODI_SEEK_THRESHOLD=0.6
