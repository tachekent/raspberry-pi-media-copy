[Unit]
Description=Video Sync Autoplay Trigger
After=sync-server.service
Wants=sync-server.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=pipe
WorkingDirectory=/home/pipe/pi-video-sync
EnvironmentFile=/home/pipe/pi-video-sync/config.env
ExecStartPre=/home/pipe/pi-video-sync/scripts/wait-ptp-lock.sh master
ExecStart=/usr/bin/python3 /home/pipe/pi-video-sync/controller/play.py ${VIDEO} --loop --duration ${DURATION} --delay 5

[Install]
WantedBy=multi-user.target
