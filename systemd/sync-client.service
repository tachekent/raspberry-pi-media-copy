[Unit]
Description=Video Sync Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-video-sync
EnvironmentFile=/home/pi/pi-video-sync/config.env
ExecStart=/usr/bin/python3 /home/pi/pi-video-sync/controller/client.py --server ${SERVER_IP}
Restart=on-failure
RestartSec=5
SupplementaryGroups=video render
# Give mpv access to the display for --vo=drm
StandardInput=tty
StandardOutput=journal
TTYPath=/dev/tty1

[Install]
WantedBy=multi-user.target
